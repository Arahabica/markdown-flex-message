{
  "name": "markdown-flex-message",
  "version": "0.3.7",
  "description": "markdown-flex-message is a converter that transforms Markdown into Flex Message for the LINE Messaging API.",
  "main": "dist/markdown-flex-message.js",
  "types": "dist/types.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome format ./src",
    "lint:fix": "biome format --write ./src"
  },
  "author": "Arahabica",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@line/bot-sdk": "^10.6.0",
    "image-size": "^2.0.2",
    "marked": "^17.0.3",
    "prismjs": "^1.30.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/tests/**/*",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">= 20"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
